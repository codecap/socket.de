---
layout: null
permalink: /en/feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    {%- assign lang = "en" -%}
    {%- assign t = site.t[lang] -%}
    
    <title>{{ site.title | xml_escape }} - {{ t.blog_title | default: "Cloud Solutions" | xml_escape }}</title>
    <description>{{ t.blog_description | default: "Latest updates and infrastructure insights from our blog" | xml_escape }}</description>
    <link>{{ site.url }}{{ site.baseurl }}/en/blog/</link>
    <atom:link href="{{ site.url }}{{ site.baseurl }}/en/feed.xml" rel="self" type="application/rss+xml" />
    <lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
    
    {% assign posts = site.blog_en | sort: 'date' | reverse %}
    {% for post in posts %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <description>
        <![CDATA[
          {% if post.image %}
            <img src="{{ site.url }}{{ site.baseurl }}{{ post.image }}" alt="{{ post.title | xml_escape }}" style="margin-bottom: 15px;" />
          {% endif %}
          {{ post.description | default: post.content | strip_html | truncatewords: 50 }}
        ]]>
      </description>
      <link>{{ site.url }}{{ site.baseurl }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ site.baseurl }}{{ post.url }}</guid>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
    </item>
    {% endfor %}
  </channel>
</rss>