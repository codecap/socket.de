---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">

{%- assign pages = site.pages | where_exp:"page", "page.sitemap != false" -%}

{%- for page in pages -%}
  {%- if page.published == false
        or page.path contains '_site'
        or page.path contains '_includes'
        or page.path contains 'robots.txt'
        or page.path contains 'sitemap.xml'
        or page.path contains 'feed.xml'
        or page.path contains 'redirects.json'
        or page.path contains '404.html'
        or page.path contains '403.html'
        or page.path contains '500.html'
        or page.path contains '503.html' -%}
      {%- continue -%}
  {%- endif -%}

  {%- unless page.url contains '/en/' or page.url contains '/de/' -%}
      {%- continue -%}
  {%- endunless -%}

  {%- capture loc_raw -%}{{ page.url | absolute_url }}{%- endcapture -%}
  {%- assign loc = loc_raw | replace_first: "https:/", "https://" | replace: ".html", "" | replace: "/index/", "/" | replace: "//", "/" -%}
  {%- assign last_char = loc | slice: -1 -%}
  {%- if last_char != "/" and loc != site.url -%}{%- assign loc = loc | append: "/" -%}{%- endif -%}

  <url>
    <loc>{{ loc }}</loc>
    <lastmod>{{ page.last_modified_at | default: site.time | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    {%- if page.key and site.t[page.key] -%}
      {%- assign translations = site.t[page.key] -%}
      {%- assign default_href = "" -%}
      {%- for t in translations -%}
        {%- assign lang = t.first -%}
        {%- capture href_raw -%}{{ t.last | absolute_url }}{%- endcapture -%}
        {%- assign href = href_raw | replace_first: "https:/", "https://" | replace: ".html", "" | replace: "/index/", "/" | replace: "//", "/" -%}
        {%- assign h_last = href | slice: -1 -%}
        {%- if h_last != "/" and href != site.url -%}{%- assign href = href | append: "/" -%}{%- endif -%}
    <xhtml:link rel="alternate" hreflang="{{ lang }}" href="{{ href }}" />
        {%- if lang == site.default_language -%}{%- assign default_href = href -%}{%- endif -%}
      {%- endfor -%}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ default_href | default: loc }}" />
    {%- else -%}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ loc }}" />
    {%- endif -%}
  </url>
{%- endfor -%}

{%- for collection in site.collections -%}
  {%- if collection.label == 'posts' -%}{%- continue -%}{%- endif -%}
  {%- for item in collection.docs -%}
    {%- if item.sitemap == false or item.published == false -%}{%- continue -%}{%- endif -%}
    {%- capture loc_raw -%}{{ item.url | absolute_url }}{%- endcapture -%}
    {%- assign loc = loc_raw | replace_first: "https:/", "https://" | replace: ".html", "" | replace: "//", "/" -%}
    {%- assign last_char = loc | slice: -1 -%}
    {%- if last_char != "/" and loc != site.url -%}{%- assign loc = loc | append: "/" -%}{%- endif -%}

  <url>
    <loc>{{ loc }}</loc>
    <lastmod>{{ item.date | default: item.last_modified_at | default: site.time | date_to_xmlschema }}</lastmod>
    <changefreq>weekly</changefreq>
    {%- if item.key and site.t[item.key] -%}
      {%- assign translations = site.t[item.key] -%}
      {%- assign default_href = "" -%}
      {%- for t in translations -%}
        {%- assign lang = t.first -%}
        {%- capture href_raw -%}{{ t.last | absolute_url }}{%- endcapture -%}
        {%- assign href = href_raw | replace_first: "https:/", "https://" | replace: ".html", "" | replace: "//", "/" -%}
        {%- assign h_last = href | slice: -1 -%}
        {%- if h_last != "/" and href != site.url -%}{%- assign href = href | append: "/" -%}{%- endif -%}
    <xhtml:link rel="alternate" hreflang="{{ lang }}" href="{{ href }}" />
        {%- if lang == site.default_language -%}{%- assign default_href = href -%}{%- endif -%}
      {%- endfor -%}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ default_href | default: loc }}" />
    {%- else -%}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ loc }}" />
    {%- endif -%}
  </url>
  {%- endfor -%}
{%- endfor -%}
</urlset>